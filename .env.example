POSTGRES_DB=venture_studio
POSTGRES_USER=venture
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://venture:change_me@db:5432/venture_studio
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_ENV=development

# Market Intelligence collectors
HACKERNEWS_ENABLED=true
RSS_ENABLED=true
RSS_FEED_URLS=https://www.producthunt.com/feed

# M3.4: Reddit high-intent discovery. Off by default -- set an explicit,
# small (3-5) comma-separated subreddit list (no "r/" prefix) and flip
# REDDIT_ENABLED=true only after a deliberate LEAD decision to start live
# discovery. Uses each subreddit's public RSS feed only -- no OAuth login.
REDDIT_ENABLED=false
REDDIT_SUBREDDITS=
